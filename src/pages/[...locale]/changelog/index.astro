---
import {createElement} from 'react';
import SectionLayout from '../../../layouts/SectionLayout.astro';
import {ChangelogPage} from '../../../ui/community/ChangelogPage';
import {pagePaths, type PageRouteProps} from '../../../content/pages';
import {postPaths} from '../../../content/posts';
import {routes} from '../../../i18n/routes';

export const getStaticPaths = () => pagePaths('changelog');
const {locale, page, alternates} = Astro.props as PageRouteProps;
const pages = await postPaths(locale);

const props = {locale, section: 'community' as const, title: page.data.title, description: page.data.description, body: page.body ?? '', pages};
---
<SectionLayout locale={locale} title={page.data.title} description={page.data.description} path={routes.page(locale, 'changelog')} alternates={alternates} section="community" current="changelog" page={createElement(ChangelogPage, props)}></SectionLayout>
