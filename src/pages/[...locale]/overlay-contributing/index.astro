---
import {createElement} from 'react';
import SectionLayout from '../../../layouts/SectionLayout.astro';
import {pagePaths, type PageRouteProps} from '../../../content/pages';
import {postPaths} from '../../../content/posts';
import {routes} from '../../../i18n/routes';
import {GuidePage} from '../../../ui/start/GuidePage';

export const getStaticPaths = () => pagePaths('overlay-contributing');
const {locale, page, alternates} = Astro.props as PageRouteProps;
const pages = await postPaths(locale);
---
<SectionLayout
  locale={locale}
  title={page.data.title}
  description={page.data.description}
  path={routes.page(locale, 'overlay-contributing')}
  alternates={alternates}
  section="community"
  current="overlayContributing"
  page={createElement(GuidePage, {locale, section: 'community', title: page.data.title, description: page.data.description, body: page.body ?? '', pages})}
></SectionLayout>
