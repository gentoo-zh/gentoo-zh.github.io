---
import {createElement} from 'react';
import SectionLayout from '../../../layouts/SectionLayout.astro';
import {pagePaths, type PageRouteProps} from '../../../content/pages';
import {postPaths} from '../../../content/posts';
import {LANGUAGE_TAG, providerMessages} from '../../../i18n/locales';
import {routes} from '../../../i18n/routes';
import LegacyAnchors from '../../../ui/LegacyAnchors.astro';
import {PackagesIsland} from '../../../ui/download/PackagesIsland';
import PackagesScript from '../../../ui/download/PackagesScript.astro';
import {PACKAGES_MESSAGE_KEYS} from '../../../ui/download/packagesData';
import {LegacyAnchorLinks} from '../../../ui/section/LegacyAnchorLinks';
import {SectionPage} from '../../../ui/section/SectionPage';

export const getStaticPaths = () => pagePaths('packages');

const {locale, page, alternates} = Astro.props as PageRouteProps;
const pages = await postPaths(locale);
const languageTag = LANGUAGE_TAG[locale];
const messages = Object.fromEntries(
  Object.entries(providerMessages(locale)[languageTag] ?? {}).filter(([key]) => PACKAGES_MESSAGE_KEYS.test(key)),
);
// The status help and scope moved to /package-status/; the table's toolbar links it and the plain-text lists.
const anchors = (page.data.anchors ?? {}) as Record<string, string>;

---
<SectionLayout
  locale={locale}
  title={page.data.title}
  description={page.data.description}
  path={routes.page(locale, 'packages')}
  alternates={alternates}
  section="download"
  current="packages"
  page={createElement(SectionPage, {locale, section: 'download', title: page.data.title, description: page.data.description, pages, isDataPage: true, isTablePage: true, body: `<!-- slot:table -->\n\n${page.body ?? ''}\n\n<!-- slot:legacy -->`, slots: {table: createElement(PackagesIsland, {props: {languageTag, messages, statusHref: routes.page(locale, 'package-status')}}), legacy: createElement(LegacyAnchorLinks, {locale, anchors})}})}
>
  <LegacyAnchors locale={locale} anchors={anchors} />
  <PackagesScript />
</SectionLayout>
