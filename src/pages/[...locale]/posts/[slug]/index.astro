---
import {createElement} from 'react';
import Base from '../../../../layouts/Base.astro';
import {getPosts, postAlternates, summarize, type Post} from '../../../../content/posts';
import {LOCALES} from '../../../../i18n/locales';
import {chapterRoute, localeParam, routes} from '../../../../i18n/routes';
import {pagedPost} from '../../../../ui/blog/pagedPosts';
import {outlineItems} from '../../../../markdown/outline';
import {BlogArticle, PagedArticle, pageList} from '../../../../ui/blog/BlogArticle';
import {renderChapterNav} from '../../../../ui/blog/renderChapterNav';
import ChapterNavScript from '../../../../ui/blog/ChapterNavScript.astro';
import LegacyAnchors from '../../../../ui/LegacyAnchors.astro';
import OutlineSpy from '../../../../ui/section/OutlineSpy.astro';

export async function getStaticPaths() {
  const perLocale = await Promise.all(LOCALES.map(getPosts));
  return perLocale.flat().map(post => ({
    params: {locale: localeParam(post.data.locale), slug: post.data.slug},
    props: {post},
  }));
}

const {post} = Astro.props as {post: Post};
const {locale, slug} = post.data;
const summary = summarize(post);
const alternates = await postAlternates(slug);
const siblings = await getPosts(locale);
const pages = new Set(siblings.map(entry => routes.post(locale, entry.data.slug)));
const index = siblings.findIndex(entry => entry.data.slug === slug);
const newer = index > 0 ? summarize(siblings[index - 1]) : null;
const older = index >= 0 && index < siblings.length - 1 ? summarize(siblings[index + 1]) : null;
// A paged post shows its overview here; old links to headings that moved to a section page follow them there.
const paged = pagedPost(post);
const props = {locale, post: summary, body: post.body ?? '', pages, newer, older};
const pagedProps = paged == null ? null : {...props, split: paged.split, groups: paged.groups, page: 0};
const moved = paged == null ? {} : Object.fromEntries([...paged.split.pageOf].filter(([, number]) => number > 0).map(([id, number]) => [id, `${chapterRoute(locale, slug, number)}#${id}`]));
// BlogArticle renders the outline from the same headings; posts without any load no spy.
const Spy = outlineItems(paged?.split.pages[0].body ?? post.body ?? '').length > 0 ? OutlineSpy : Fragment;
const Anchors = paged == null ? Fragment : LegacyAnchors;
const nav = pagedProps == null ? null : await renderChapterNav(pageList(pagedProps));
const NavScript = nav == null ? Fragment : ChapterNavScript;
---
<Base locale={locale} title={summary.title} description={summary.description} path={routes.post(locale, slug)} alternates={alternates} article={{title: summary.title, datePublished: post.data.date.toISOString(), dateModified: (post.data.lastmod ?? post.data.date).toISOString(), authors: summary.authors}} section="community" sideNav={nav?.sideNav} page={pagedProps == null || nav == null ? createElement(BlogArticle, props) : createElement(PagedArticle, {...pagedProps, pageList: nav.pageList})}>
  <Spy />
  <Anchors anchors={moved} />
  <NavScript />
</Base>
