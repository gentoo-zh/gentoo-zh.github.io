---
import SectionLayout from '../../../layouts/SectionLayout.astro';
import {guideLayout} from '../../../layouts/GuideLayout';
import {guidePaths, type GuideRouteProps} from '../../../content/pages';
import GuideSetupScript from '../../../ui/start/GuideSetupScript.astro';

export const getStaticPaths = () => guidePaths('gentoo-binpkg-setup');

const props = Astro.props as GuideRouteProps;
const layout = await guideLayout(props, {current: 'gentooBinpkgSetup', kind: 'official', setupAnchor: 'binhost', controls: {protocolSources: false, sudo: true}});
---
<SectionLayout {...layout}>
  <GuideSetupScript />
</SectionLayout>
