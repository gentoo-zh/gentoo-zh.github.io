---
import {createElement} from 'react';
import SectionLayout from '../../../layouts/SectionLayout.astro';
import {AboutPage} from '../../../ui/about/AboutPage';
import {pagePaths, type PageRouteProps} from '../../../content/pages';
import {postPaths} from '../../../content/posts';
import {routes} from '../../../i18n/routes';

export const getStaticPaths = () => pagePaths('about');
const {locale, page, alternates} = Astro.props as PageRouteProps;
const pages = await postPaths(locale);

const props = {locale, section: 'about' as const, title: page.data.title, description: page.data.description, body: page.body ?? '', pages};
---
<SectionLayout locale={locale} title={page.data.title} description={page.data.description} path={routes.page(locale, 'about')} alternates={alternates} section="about" current="about" page={createElement(AboutPage, props)}></SectionLayout>
