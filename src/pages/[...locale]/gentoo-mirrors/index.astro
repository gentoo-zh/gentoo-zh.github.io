---
import {createElement} from 'react';
import SectionLayout from '../../../layouts/SectionLayout.astro';
import {pagePaths, type PageRouteProps} from '../../../content/pages';
import {postPaths} from '../../../content/posts';
import {loadData} from '../../../data/entries';
import {OfficialMirrorTable} from '../../../ui/download/OfficialMirrorTable';
import {routes} from '../../../i18n/routes';
import {SectionPage} from '../../../ui/section/SectionPage';

export const getStaticPaths = () => pagePaths('gentoo-mirrors');

const {locale, page, alternates} = Astro.props as PageRouteProps;
const pages = await postPaths(locale);
const mirrors = await loadData('mirrors');
const props = {locale, section: 'download' as const, title: page.data.title, description: page.data.description, body: page.body ?? '', pages, slots: {mirrors: createElement(OfficialMirrorTable, {locale, mirrors})}};
---
<SectionLayout
  locale={locale}
  title={page.data.title}
  description={page.data.description}
  path={routes.page(locale, 'gentoo-mirrors')}
  alternates={alternates}
  section="download"
  current="gentooMirrors"
  page={createElement(SectionPage, props)}
/>
