---
// Before paint, restore a sidebar list's scroll position and keep its selected row in view; SectionNavScript
// and ChapterNavScript render it ahead of the module that schedules their island.
interface Props {
  /** The island's selector; a page may hold more than one copy of the list. */
  selector: string;
  /** The sessionStorage key the scroll position is kept under. */
  storageKey: string;
}

const {selector, storageKey: key} = Astro.props;
---
<script is:inline data-owner="src/ui/section/SidebarScrollScript.astro" define:vars={{selector, key}}>
  (function () {
    // The copy that scrolls in the sidebar: a phone list starts closed, and the sidebar is hidden where it shows.
    const root = Array.from(document.querySelectorAll(selector)).find(function (element) { return element.parentElement?.clientHeight; });
    const scroll = root?.parentElement;
    const selected = root?.querySelector('[aria-current="page"]');
    if (!scroll || !selected) return;
    // Run after HeaderOffset, before paint and hydration; scroll only the sidebar.
    try { scroll.scrollTop = Number(sessionStorage.getItem(key)) || 0; } catch {}
    const bounds = scroll.getBoundingClientRect();
    const item = selected.getBoundingClientRect();
    if (item.top < bounds.top) scroll.scrollTop += item.top - bounds.top;
    else if (item.bottom > bounds.bottom) scroll.scrollTop += item.bottom - bounds.bottom;
    window.addEventListener('pagehide', function () {
      try { sessionStorage.setItem(key, String(scroll.scrollTop)); } catch {}
    });
  })();
</script>
