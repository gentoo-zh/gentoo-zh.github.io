---
// Before paint, restore the sidebar's scroll position and keep the current page in view. The groups fold
// once the island mounts, on first use or when idle; a plain click on a group header is held until then.
import {islandSelector} from '../islands/kinds';

const selector = islandSelector('section');
---
<script is:inline data-owner="src/ui/section/SectionNavScript.astro" define:vars={{selector}}>
  (function () {
    const root = document.querySelector(selector);
    const scroll = root?.parentElement;
    const selected = root?.querySelector('[aria-current="page"]');
    if (!scroll?.clientHeight || !selected) return;
    // Run after HeaderOffset, before paint and hydration; scroll only the sidebar.
    const key = 'gz-section-scroll';
    try { scroll.scrollTop = Number(sessionStorage.getItem(key)) || 0; } catch {}
    const bounds = scroll.getBoundingClientRect();
    const item = selected.getBoundingClientRect();
    if (item.top < bounds.top) scroll.scrollTop += item.top - bounds.top;
    else if (item.bottom > bounds.bottom) scroll.scrollTop += item.bottom - bounds.bottom;
    window.addEventListener('pagehide', function () {
      try { sessionStorage.setItem(key, String(scroll.scrollTop)); } catch {}
    });
  })();
</script>
<script>
  import {buttons, hydrated, links, marked} from '../islands/intent';
  import {islandSelector} from '../islands/kinds';
  import {schedule} from '../islands/schedule';
  import {SECTION_GROUP_ATTRIBUTE} from './sectionNavMarks';

  const root = document.querySelector(islandSelector('section'));
  if (root != null) {
    void schedule(
      'section',
      [
        // A modified or middle click on a header opens its category page natively.
        {kind: 'intent', on: links(root, marked(SECTION_GROUP_ATTRIBUTE))},
        // The chevron beside each header folds its group.
        {kind: 'intent', on: buttons(root, hydrated('button[aria-controls]'))},
        {kind: 'idle'},
      ],
      () => import('./section-nav-client').then(({mount}) => mount()),
    );
  }
</script>
